{
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "includeFiles": "public/data/**"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/assets/(.*)", "destination": "/public/assets/$1" },
    { "source": "/uploads/(.*)", "destination": "/public/uploads/$1" },
    { "source": "/data/(.*)", "destination": "/public/data/$1" },
    { "source": "/admin", "destination": "/pages/admin.html" },
    { "source": "/admin.html", "destination": "/pages/admin.html" },
    { "source": "/about", "destination": "/pages/about.html" },
    { "source": "/about.html", "destination": "/pages/about.html" },
    { "source": "/contact", "destination": "/pages/contact.html" },
    { "source": "/contact.html", "destination": "/pages/contact.html" },
    { "source": "/process", "destination": "/pages/process.html" },
    { "source": "/process.html", "destination": "/pages/process.html" },
    { "source": "/export", "destination": "/pages/export.html" },
    { "source": "/export.html", "destination": "/pages/export.html" },
    { "source": "/gallery", "destination": "/pages/gallery.html" },
    { "source": "/gallery.html", "destination": "/pages/gallery.html" },
    { "source": "/products", "destination": "/pages/products.html" },
    { "source": "/products.html", "destination": "/pages/products.html" },
    { "source": "/track-shipment", "destination": "/pages/track-shipment.html" },
    { "source": "/track-shipment.html", "destination": "/pages/track-shipment.html" },
    { "source": "/blog", "destination": "/pages/blog.html" },
    { "source": "/blog.html", "destination": "/pages/blog.html" },
    { "source": "/blog/:slug", "destination": "/pages/blog-post.html" },
    { "source": "/blog-post.html", "destination": "/pages/blog-post.html" },
    { "source": "/category.html", "destination": "/pages/category.html" },
    { "source": "/product-detail.html", "destination": "/pages/product-detail.html" },
    { "source": "/privacy", "destination": "/pages/privacy.html" },
    { "source": "/privacy.html", "destination": "/pages/privacy.html" },
    { "source": "/terms", "destination": "/pages/terms.html" },
    { "source": "/terms.html", "destination": "/pages/terms.html" },
    { "source": "/terms-of-supply", "destination": "/pages/terms-of-supply.html" },
    { "source": "/terms-of-supply.html", "destination": "/pages/terms-of-supply.html" },
    { "source": "/voice-coils", "destination": "/pages/category.html" },
    { "source": "/speaker-cones", "destination": "/pages/category.html" },
    { "source": "/speaker-surrounds", "destination": "/pages/category.html" },
    { "source": "/speaker-spiders", "destination": "/pages/category.html" },
    { "source": "/dust-caps", "destination": "/pages/category.html" },
    { "source": "/diaphragms", "destination": "/pages/category.html" },
    { "source": "/lead-wires", "destination": "/pages/category.html" },
    { "source": "/speaker-terminals", "destination": "/pages/category.html" },
    { "source": "/subwoofers", "destination": "/pages/category.html" },
    { "source": "/speaker-edge-ports", "destination": "/pages/category.html" },
    { "source": "/custom-repair-kits", "destination": "/pages/category.html" },
    { "source": "/custom-recone-kits", "destination": "/pages/category.html" },
    { "source": "/voice-coils/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/speaker-cones/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/speaker-surrounds/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/speaker-spiders/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/dust-caps/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/diaphragms/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/lead-wires/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/speaker-terminals/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/subwoofers/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/speaker-edge-ports/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/custom-repair-kits/:slug", "destination": "/pages/product-detail.html" },
    { "source": "/custom-recone-kits/:slug", "destination": "/pages/product-detail.html" }
  ]
}
